# Clerk (clerk.com → your application → API keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Paystack (dashboard → Settings → API Keys & Webhooks); webhook URL: https://<site>/api/paystack/webhook
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=

# Upstash Redis (console.upstash.com → your database → REST API)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# From `npm run keygen` (one line, \n for line breaks)
LICENCE_PRIVATE_KEY=

# Clerk user ids allowed into /admin, comma-separated
ADMIN_USER_IDS=
