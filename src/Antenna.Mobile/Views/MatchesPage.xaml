<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:Antenna.Mobile.Views"
             x:Class="Antenna.Mobile.Views.MatchesPage"
             x:DataType="views:MatchesPage"
             Title="Matches">
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Refresh" Clicked="Refresh_Clicked" />
    </ContentPage.ToolbarItems>
    <Grid RowDefinitions="Auto,Auto,Auto,*">
        <CollectionView x:Name="Days" SelectionMode="Single" HeightRequest="48" Margin="12,0"
                        SelectionChanged="Days_SelectionChanged">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Horizontal" ItemSpacing="8" />
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="views:GroupChip">
                    <Border StrokeShape="RoundRectangle 16" Padding="14,6" Margin="0,6" StrokeThickness="0"
                            BackgroundColor="{StaticResource Surface}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup Name="CommonStates">
                                <VisualState Name="Normal" />
                                <VisualState Name="Selected">
                                    <VisualState.Setters>
                                        <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Label Text="{Binding Name}" VerticalOptions="Center" />
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto" Padding="16,0" ColumnSpacing="8">
            <Picker x:Name="SportPicker" Title="Sport" SelectedIndexChanged="Filter_Changed" />
            <Label Grid.Column="1" Text="My channels" VerticalOptions="Center" />
            <Switch x:Name="MineOnly" Grid.Column="2" Toggled="Filter_Changed" />
        </Grid>

        <Label x:Name="StatusText" Grid.Row="2" Margin="16,4" FontSize="12" TextColor="{StaticResource Muted}" />

        <CollectionView x:Name="List" Grid.Row="3" SelectionMode="None" IsGrouped="True">
            <CollectionView.EmptyView>
                <Label x:Name="EmptyText" Margin="24" HorizontalTextAlignment="Center" TextColor="{StaticResource Muted}" />
            </CollectionView.EmptyView>
            <CollectionView.GroupHeaderTemplate>
                <DataTemplate x:DataType="views:MatchGroup">
                    <Label Text="{Binding League}" FontSize="16" FontAttributes="Bold" Margin="16,16,16,4" />
                </DataTemplate>
            </CollectionView.GroupHeaderTemplate>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="views:MatchRow">
                    <Border Margin="12,4" Padding="12,10" StrokeThickness="0" StrokeShape="RoundRectangle 10"
                            BackgroundColor="{StaticResource Surface}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="Match_Tapped" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="64,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="6">
                            <VerticalStackLayout VerticalOptions="Center">
                                <Label Text="{Binding Time}" TextColor="{Binding TimeColour}" FontAttributes="Bold" />
                                <Label Text="{Binding Star}" TextColor="#E8A33D" FontSize="16" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="4" IsVisible="{Binding HasTeams}">
                                <Grid ColumnDefinitions="22,*,Auto" ColumnSpacing="8">
                                    <Image Source="{Binding HomeLogo}" HeightRequest="20" WidthRequest="20" />
                                    <Label Grid.Column="1" Text="{Binding Home}" LineBreakMode="TailTruncation" />
                                    <Label Grid.Column="2" Text="{Binding HomeScore}" FontAttributes="Bold" />
                                </Grid>
                                <Grid ColumnDefinitions="22,*,Auto" ColumnSpacing="8">
                                    <Image Source="{Binding AwayLogo}" HeightRequest="20" WidthRequest="20" />
                                    <Label Grid.Column="1" Text="{Binding Away}" LineBreakMode="TailTruncation" />
                                    <Label Grid.Column="2" Text="{Binding AwayScore}" FontAttributes="Bold" />
                                </Grid>
                            </VerticalStackLayout>
                            <Label Grid.Column="1" Text="{Binding Name}" FontAttributes="Bold" IsVisible="{Binding HasNoTeams}" />
                            <Label Grid.Row="1" Grid.Column="1" Text="{Binding Channel}" TextColor="{Binding ChannelColour}" FontSize="13"
                                   LineBreakMode="TailTruncation" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <ActivityIndicator x:Name="Busy" Grid.Row="3" VerticalOptions="Start" Margin="0,24" />
    </Grid>
</ContentPage>
