<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:Antenna.Mobile.Views"
             x:Class="Antenna.Mobile.Views.LiveTvPage"
             x:DataType="views:LiveTvPage"
             Title="Live TV">
    <Grid RowDefinitions="Auto,Auto,*">
        <SearchBar x:Name="SearchBox" Placeholder="Search channels" TextChanged="SearchBox_TextChanged" />

        <CollectionView x:Name="Chips" Grid.Row="1" SelectionMode="Single" HeightRequest="48"
                        SelectionChanged="Chips_SelectionChanged">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Horizontal" ItemSpacing="8" />
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="views:GroupChip">
                    <Border StrokeShape="RoundRectangle 16" Padding="14,6" Margin="0,6" StrokeThickness="0"
                            BackgroundColor="{StaticResource Surface}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup Name="CommonStates">
                                <VisualState Name="Normal" />
                                <VisualState Name="Selected">
                                    <VisualState.Setters>
                                        <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Label Text="{Binding Name}" VerticalOptions="Center" />
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <CollectionView x:Name="Channels" Grid.Row="2" SelectionMode="None"
                        RemainingItemsThreshold="30" RemainingItemsThresholdReached="Channels_RemainingItemsThresholdReached">
            <CollectionView.EmptyView>
                <Label x:Name="EmptyText" Margin="24" HorizontalTextAlignment="Center" TextColor="{StaticResource Muted}"
                       Text="Add a playlist on the Playlists tab to get started." />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="views:ChannelRow">
                    <Grid ColumnDefinitions="56,*" Padding="12,8" ColumnSpacing="12">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="Channel_Tapped" />
                        </Grid.GestureRecognizers>
                        <Border WidthRequest="56" HeightRequest="40" StrokeThickness="0" StrokeShape="RoundRectangle 6"
                                BackgroundColor="{StaticResource Surface}">
                            <Grid>
                                <Label Text="{Binding Initials}" HorizontalOptions="Center" VerticalOptions="Center"
                                       TextColor="{StaticResource Muted}" />
                                <Image Source="{Binding Logo}" Aspect="AspectFit" Margin="2" />
                            </Grid>
                        </Border>
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                            <Label Text="{Binding Title}" FontAttributes="Bold" LineBreakMode="TailTruncation" />
                            <Label Text="{Binding Subtitle}" FontSize="13" TextColor="{StaticResource Muted}" LineBreakMode="TailTruncation" />
                            <ProgressBar Progress="{Binding Progress}" IsVisible="{Binding HasProgramme}" HeightRequest="3" />
                        </VerticalStackLayout>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <ActivityIndicator x:Name="Busy" Grid.Row="2" IsRunning="False" VerticalOptions="Start" Margin="0,24" />
    </Grid>
</ContentPage>
