<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:Antenna.Mobile.Views"
             x:Class="Antenna.Mobile.Views.PlaylistsPage"
             x:DataType="views:PlaylistsPage"
             Title="Playlists">
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Add" Clicked="Add_Clicked" />
        <ToolbarItem Text="Sync with PC" Order="Secondary" Clicked="Sync_Clicked" />
        <ToolbarItem Text="Refresh all" Order="Secondary" Clicked="RefreshAll_Clicked" />
        <ToolbarItem Text="Share log" Order="Secondary" Clicked="ShareLog_Clicked" />
    </ContentPage.ToolbarItems>
    <Grid RowDefinitions="Auto,*,Auto">
        <Label x:Name="Progress" Margin="16,8" IsVisible="False" TextColor="{StaticResource Muted}" />
        <CollectionView x:Name="Sources" Grid.Row="1" SelectionMode="None">
            <CollectionView.EmptyView>
                <VerticalStackLayout Margin="24" Spacing="16">
                    <Label HorizontalTextAlignment="Center" TextColor="{StaticResource Muted}"
                           Text="Add your M3U link or Xtream Codes login from your TV provider." />
                    <Button Text="Add a playlist" HorizontalOptions="Center" Clicked="Add_Clicked" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="views:SourceRow">
                    <Grid ColumnDefinitions="6,*,Auto,Auto" Padding="12,10" ColumnSpacing="12">
                        <BoxView Color="{Binding Color}" CornerRadius="3" />
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                            <Label Text="{Binding Name}" FontAttributes="Bold" />
                            <Label Text="{Binding Details}" FontSize="13" TextColor="{StaticResource Muted}" />
                        </VerticalStackLayout>
                        <Button Grid.Column="2" Text="Refresh" Clicked="Refresh_Clicked" />
                        <Button Grid.Column="3" Text="Delete" BackgroundColor="Transparent" TextColor="{StaticResource Muted}" Clicked="Delete_Clicked" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        <Label x:Name="VersionText" Grid.Row="2" Margin="16,8" FontSize="12" TextColor="{StaticResource Muted}" HorizontalOptions="Center" />
    </Grid>
</ContentPage>
