<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:Antenna.Mobile.Views"
             x:Class="Antenna.Mobile.Views.AddPlaylistPage"
             x:DataType="views:AddPlaylistPage"
             Title="Add playlist">
    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12">
            <Picker x:Name="KindPicker" Title="Type" SelectedIndexChanged="KindPicker_SelectedIndexChanged">
                <Picker.ItemsSource>
                    <x:Array Type="{x:Type x:String}">
                        <x:String>M3U link</x:String>
                        <x:String>M3U file on this phone</x:String>
                        <x:String>Xtream Codes login</x:String>
                    </x:Array>
                </Picker.ItemsSource>
            </Picker>

            <Entry x:Name="NameBox" Placeholder="Name (e.g. My provider)" />

            <Entry x:Name="LocationBox" Placeholder="M3U link (http://…)" Keyboard="Url" IsSpellCheckEnabled="False" IsTextPredictionEnabled="False" />
            <Button x:Name="PickFileButton" Text="Choose M3U file…" IsVisible="False" Clicked="PickFile_Clicked" />
            <Label x:Name="FileText" IsVisible="False" TextColor="{StaticResource Muted}" />

            <Entry x:Name="UserBox" Placeholder="Username" IsVisible="False" IsSpellCheckEnabled="False" IsTextPredictionEnabled="False" />
            <Entry x:Name="PasswordBox" Placeholder="Password" IsPassword="True" IsVisible="False" />

            <Entry x:Name="EpgBox" Placeholder="Guide (XMLTV) link, optional" Keyboard="Url" IsSpellCheckEnabled="False" IsTextPredictionEnabled="False" />

            <Label x:Name="ErrorText" TextColor="#FF7A7A" IsVisible="False" />
            <Button x:Name="SaveButton" Text="Add and load" Clicked="Save_Clicked" />
            <ActivityIndicator x:Name="Busy" />
            <Label x:Name="BusyText" HorizontalOptions="Center" TextColor="{StaticResource Muted}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
