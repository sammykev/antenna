<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:Antenna.Mobile.Views"
             x:Class="Antenna.Mobile.Views.GuideSearchPage"
             x:DataType="views:GuideSearchPage"
             Title="Guide">
    <Grid RowDefinitions="Auto,*">
        <SearchBar x:Name="SearchBox" Placeholder="Search programmes (e.g. Arsenal, Match of the Day)" TextChanged="SearchBox_TextChanged" />
        <CollectionView x:Name="Results" Grid.Row="1" SelectionMode="None">
            <CollectionView.EmptyView>
                <Label x:Name="EmptyText" Margin="24" HorizontalTextAlignment="Center" TextColor="{StaticResource Muted}"
                       Text="Find programmes on all your channels, today and over the next week." />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="views:GuideRow">
                    <VerticalStackLayout Padding="16,10" Spacing="2">
                        <VerticalStackLayout.GestureRecognizers>
                            <TapGestureRecognizer Tapped="Result_Tapped" />
                        </VerticalStackLayout.GestureRecognizers>
                        <Label Text="{Binding Title}" FontAttributes="Bold" LineBreakMode="TailTruncation" />
                        <Label FontSize="13" TextColor="{StaticResource Muted}">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="{Binding Time}" />
                                    <Span Text="  ·  " />
                                    <Span Text="{Binding Subtitle}" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                    </VerticalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        <ActivityIndicator x:Name="Busy" Grid.Row="1" VerticalOptions="Start" Margin="0,24" />
    </Grid>
</ContentPage>
