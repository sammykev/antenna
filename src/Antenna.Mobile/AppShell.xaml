<?xml version="1.0" encoding="UTF-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:views="clr-namespace:Antenna.Mobile.Views"
       x:Class="Antenna.Mobile.AppShell"
       Shell.NavBarHasShadow="False">
    <TabBar>
        <ShellContent Title="Live TV" Route="live" ContentTemplate="{DataTemplate views:LiveTvPage}" />
        <ShellContent Title="Movies" Route="movies" ContentTemplate="{DataTemplate views:MoviesPage}" />
        <ShellContent Title="Series" Route="series" ContentTemplate="{DataTemplate views:SeriesPage}" />
        <ShellContent Title="Matches" Route="matches" ContentTemplate="{DataTemplate views:MatchesPage}" />
        <ShellContent Title="Playlists" Route="playlists" ContentTemplate="{DataTemplate views:PlaylistsPage}" />
    </TabBar>
</Shell>
