<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Android phones only for now (see ROADMAP.md). -->
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>26.0</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <RootNamespace>Antenna.Mobile</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <MauiXamlInflator>SourceGen</MauiXamlInflator>

    <ApplicationTitle>Antenna</ApplicationTitle>
    <ApplicationId>io.github.sammykev.antenna</ApplicationId>

    <!-- The release workflow passes the real version; versionCode is derived from it (1.2.3 -> 10203). -->
    <ApplicationDisplayVersion>0.1.0</ApplicationDisplayVersion>
    <ApplicationVersion>$([MSBuild]::Add($([MSBuild]::Add($([MSBuild]::Multiply($([System.Version]::Parse($(ApplicationDisplayVersion)).Major), 10000)), $([MSBuild]::Multiply($([System.Version]::Parse($(ApplicationDisplayVersion)).Minor), 100)))), $([System.Version]::Parse($(ApplicationDisplayVersion)).Build)))</ApplicationVersion>

    <!-- One APK for every phone (64- and 32-bit ARM); no emulator ABIs, they only add size. -->
    <AndroidPackageFormats>apk</AndroidPackageFormats>
    <RuntimeIdentifiers>android-arm64;android-arm</RuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.png" ForegroundScale="0.7" Color="#12151C" />
    <MauiSplashScreen Include="Resources\Splash\splash.png" Color="#12151C" BaseSize="128,128" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <PackageReference Include="LibVLCSharp.MAUI" Version="3.10.2" />
    <PackageReference Include="VideoLAN.LibVLC.Android" Version="3.6.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Antenna.Core\Antenna.Core.csproj" />
  </ItemGroup>

</Project>
