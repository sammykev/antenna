<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Antenna.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Antenna">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom title bar: the app draws into the caption area. -->
        <Grid x:Name="AppTitleBar" Height="36" Padding="16,0,140,0" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Image x:Name="TitleLogo" Width="18" Height="18" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="Antenna" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
        </Grid>

        <NavigationView
            x:Name="NavView"
            Grid.Row="1"
            IsSettingsVisible="False"
            IsBackButtonVisible="Auto"
            IsBackEnabled="{x:Bind ContentFrame.CanGoBack, Mode=OneWay}"
            BackRequested="NavView_BackRequested"
            ItemInvoked="NavView_ItemInvoked"
            PaneDisplayMode="Left">

            <NavigationView.AutoSuggestBox>
                <AutoSuggestBox
                    x:Name="SearchBox"
                    PlaceholderText="Search all playlists"
                    QueryIcon="Find"
                    TextChanged="SearchBox_TextChanged"
                    QuerySubmitted="SearchBox_QuerySubmitted" />
            </NavigationView.AutoSuggestBox>

            <NavigationView.MenuItems>
                <NavigationViewItem Content="Live TV" Tag="live">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7F4;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Guide" Tag="guide">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE787;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Live events" Tag="events">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE909;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Movies" Tag="movies">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8B2;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Series" Tag="series">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7F7;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItemSeparator />
                <NavigationViewItem Content="My stuff" Tag="favourites">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE734;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Multi-view" Tag="multiview">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xF0E2;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Recordings" Tag="recordings">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7C8;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="Playlists" Tag="playlists">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE90B;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Settings" Tag="settings">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <Grid>
                <Frame x:Name="ContentFrame" Navigated="ContentFrame_Navigated" />
                <InfoBar x:Name="Notice" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="16" MaxWidth="520" IsClosable="True" />
            </Grid>
        </NavigationView>

        <!-- Start-up screen: what's in the library. It stays until a tile (or Continue) is chosen. -->
        <Grid x:Name="Splash" Grid.Row="1" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="28" Margin="24,0,24,48">
                <StackPanel Spacing="10">
                    <Image x:Name="SplashLogo" Width="112" Height="112" />
                    <TextBlock Text="Antenna" Style="{StaticResource TitleLargeTextBlockStyle}" HorizontalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="16" HorizontalAlignment="Center">
                    <Button Tag="live" Click="SplashTile_Click" Width="176" Padding="20,18" CornerRadius="12"
                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                            ToolTipService.ToolTip="Open Live channels">
                        <StackPanel Spacing="6">
                            <FontIcon Glyph="&#xE7F4;" FontSize="20" HorizontalAlignment="Left"
                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock x:Name="LiveCount" Text="–" FontSize="34" FontWeight="SemiBold" />
                            <TextBlock Text="Live channels" Opacity="0.7" />
                        </StackPanel>
                    </Button>
                    <Button Tag="movies" Click="SplashTile_Click" Width="176" Padding="20,18" CornerRadius="12"
                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                            ToolTipService.ToolTip="Open Movies">
                        <StackPanel Spacing="6">
                            <FontIcon Glyph="&#xE8B2;" FontSize="20" HorizontalAlignment="Left"
                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock x:Name="MovieCount" Text="–" FontSize="34" FontWeight="SemiBold" />
                            <TextBlock Text="Movies" Opacity="0.7" />
                        </StackPanel>
                    </Button>
                    <Button Tag="series" Click="SplashTile_Click" Width="176" Padding="20,18" CornerRadius="12"
                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                            ToolTipService.ToolTip="Open Series">
                        <StackPanel Spacing="6">
                            <FontIcon Glyph="&#xE7F7;" FontSize="20" HorizontalAlignment="Left"
                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock x:Name="SeriesCount" Text="–" FontSize="34" FontWeight="SemiBold" />
                            <TextBlock Text="Series" Opacity="0.7" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel Spacing="8" HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                        <ProgressRing x:Name="SplashRing" Width="16" Height="16" IsActive="True" />
                        <TextBlock x:Name="SplashStatus" Text="Loading your library…" Opacity="0.7" />
                    </StackPanel>
                    <HyperlinkButton x:Name="SplashContinue" Click="SplashContinue_Click" HorizontalAlignment="Center" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
