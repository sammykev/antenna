<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Antenna.App.Views.PlaylistsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Antenna.App.ViewModels">

    <Grid Padding="24,16,24,0" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Spacing="16">
            <TextBlock Text="Playlists" Style="{StaticResource TitleTextBlockStyle}" />
            <Button Style="{StaticResource AccentButtonStyle}" Click="Add_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE710;" FontSize="14" />
                    <TextBlock Text="Add playlist" />
                </StackPanel>
            </Button>
        </StackPanel>

        <InfoBar x:Name="Status" Grid.Row="1" IsClosable="True" />

        <ListView x:Name="Sources" Grid.Row="2" SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:SourceViewModel">
                    <Grid Padding="0,10" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Width="40" Height="40" CornerRadius="20" Background="{x:Bind Brush}">
                            <FontIcon Glyph="{x:Bind Icon}" Foreground="White" FontSize="18" />
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" />
                            <TextBlock Text="{x:Bind Details}" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                            <Button Content="Refresh" Tag="{x:Bind}" Click="Refresh_Click" />
                            <Button Content="Edit" Tag="{x:Bind}" Click="Edit_Click" />
                            <Button Tag="{x:Bind}" Click="MoveUp_Click" ToolTipService.ToolTip="Move up">
                                <FontIcon Glyph="&#xE70E;" FontSize="12" />
                            </Button>
                            <Button Tag="{x:Bind}" Click="MoveDown_Click" ToolTipService.ToolTip="Move down">
                                <FontIcon Glyph="&#xE70D;" FontSize="12" />
                            </Button>
                            <Button Content="Remove" Tag="{x:Bind}" Click="Remove_Click" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- First run: nothing added yet. -->
        <StackPanel x:Name="Welcome" Grid.Row="2" Spacing="14" Visibility="Collapsed" Margin="0,48,0,0"
                    HorizontalAlignment="Center" MaxWidth="520">
            <Image x:Name="WelcomeLogo" Width="112" Height="112" HorizontalAlignment="Center" />
            <TextBlock Text="Welcome to Antenna" Style="{StaticResource TitleTextBlockStyle}" HorizontalAlignment="Center" />
            <TextBlock TextWrapping="Wrap" TextAlignment="Center" Opacity="0.8"
                       Text="Add the M3U link or Xtream Codes login from your IPTV provider. Channels, movies, series and the TV guide load automatically." />
            <Button Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Center" Click="Add_Click" Content="Add your first playlist" />
        </StackPanel>

        <ProgressBar x:Name="Busy" Grid.Row="2" VerticalAlignment="Top" IsIndeterminate="True" Visibility="Collapsed" />
    </Grid>
</Page>
