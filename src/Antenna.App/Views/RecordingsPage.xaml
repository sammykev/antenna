<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Antenna.App.Views.RecordingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="24,16,16,0" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Spacing="12">
            <TextBlock Text="Recordings &amp; downloads" Style="{StaticResource TitleTextBlockStyle}" />
            <Button Content="Open folder" Click="OpenFolder_Click" VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock Grid.Row="1" Opacity="0.7" TextWrapping="Wrap"
                   Text="Record from the player's ● button, or right-click a programme in the Guide. Download movies and episodes from their pages. Scheduled recordings run only while Antenna is open." />

        <ListView x:Name="RecordingList" Grid.Row="2" SelectionMode="None" />
        <TextBlock x:Name="Empty" Grid.Row="2" Text="Nothing recorded or downloaded yet." Opacity="0.7"
                   HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
    </Grid>
</Page>
