<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Antenna.App.Views.SearchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Antenna.App.Views">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <views:ItemTemplates />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Page.Resources>

    <Grid Padding="24,16,16,0" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="Header" Style="{StaticResource TitleTextBlockStyle}" />

        <SelectorBar x:Name="KindFilter" Grid.Row="1" SelectionChanged="KindFilter_SelectionChanged">
            <SelectorBarItem Text="Everything" Tag="all" IsSelected="True" />
            <SelectorBarItem Text="Live TV" Tag="live" />
            <SelectorBarItem Text="Movies" Tag="movie" />
            <SelectorBarItem Text="Series" Tag="series" />
        </SelectorBar>

        <GridView x:Name="Results" Grid.Row="2" IsItemClickEnabled="True" SelectionMode="None"
                  ItemClick="Results_ItemClick" ItemTemplate="{StaticResource ItemTileTemplate}" />

        <TextBlock x:Name="NoResults" Grid.Row="2" Text="No matches in any playlist." Opacity="0.7"
                   HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
    </Grid>
</Page>
