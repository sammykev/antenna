<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Antenna.App.Views.FavouritesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Antenna.App.Views">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <views:ItemTemplates />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Page.Resources>

    <Grid Padding="24,16,16,0" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Text="My list" Style="{StaticResource LargeTitleStyle}" />

        <Grid Grid.Row="1">
            <SelectorBar x:Name="Tabs" SelectionChanged="Tabs_SelectionChanged">
                <SelectorBarItem Text="Favourites" Tag="fav" IsSelected="True" />
                <SelectorBarItem Text="Continue watching" Tag="continue" />
                <SelectorBarItem Text="Recently watched" Tag="recent" />
                <SelectorBarItem Text="Pinned categories" Tag="pinned" />
            </SelectorBar>
            <Button x:Name="ClearButton" Content="Clear history" HorizontalAlignment="Right" Visibility="Collapsed" Click="Clear_Click" />
        </Grid>

        <GridView x:Name="Favourites" Grid.Row="2" IsItemClickEnabled="True" SelectionMode="None"
                  ItemClick="Favourites_ItemClick" RightTapped="Favourites_RightTapped"
                  ItemTemplate="{StaticResource ItemTileTemplate}" />

        <ListView x:Name="History" Grid.Row="2" IsItemClickEnabled="True" SelectionMode="None" Visibility="Collapsed"
                  ItemClick="History_ItemClick" RightTapped="History_RightTapped"
                  ItemTemplate="{StaticResource WatchRowTemplate}" />

        <ListView x:Name="Pinned" Grid.Row="2" IsItemClickEnabled="True" SelectionMode="None" Visibility="Collapsed"
                  ItemClick="Pinned_ItemClick" />

        <StackPanel x:Name="EmptyState" Grid.Row="2" Spacing="8" Visibility="Collapsed"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock x:Name="EmptyTitle" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" />
            <TextBlock x:Name="EmptyDetail" Opacity="0.7" HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="420" TextAlignment="Center" />
        </StackPanel>
    </Grid>
</Page>
