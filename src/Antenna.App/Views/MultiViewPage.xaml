<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Antenna.App.Views.MultiViewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Black">

    <!-- Up to four streams at once. Tap a tile to hear it; double-click to make it the big one. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid x:Name="Toolbar" Padding="12,8" ColumnSpacing="8" RequestedTheme="Dark">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Click="Back_Click" ToolTipService.ToolTip="Back">
                    <FontIcon Glyph="&#xE72B;" />
                </Button>
                <TextBlock Text="Multi-view" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Grid.Column="1" Foreground="#99FFFFFF" VerticalAlignment="Center" Margin="12,0" TextTrimming="CharacterEllipsis"
                       Text="Only the selected tile (blue, 🔊) has sound · click a tile or press 1–4 to switch · double-click to make it big" />
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                <SelectorBar x:Name="LayoutChoice" SelectionChanged="Layout_SelectionChanged">
                    <SelectorBarItem Text="2 × 2" Tag="grid" IsSelected="True" />
                    <SelectorBarItem Text="1 + 3" Tag="focus" />
                    <SelectorBarItem Text="Side by side" Tag="pair" />
                </SelectorBar>
                <Button Click="FullScreen_Click" ToolTipService.ToolTip="Full screen (F) · Esc to leave">
                    <FontIcon x:Name="FullScreenIcon" Glyph="&#xE740;" />
                </Button>
            </StackPanel>
        </Grid>
        <Grid x:Name="Slots" Grid.Row="1" RowSpacing="2" ColumnSpacing="2" />
    </Grid>

    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="F" Invoked="FullScreen_Invoked" />
        <KeyboardAccelerator Key="Escape" Invoked="Escape_Invoked" />
    </Page.KeyboardAccelerators>
</Page>
