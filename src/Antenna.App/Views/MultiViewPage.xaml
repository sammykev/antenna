<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Antenna.App.Views.MultiViewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Black">

    <!-- Up to four streams at once. Click a tile to hear it; the others are muted. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Spacing="8" Padding="12,8" RequestedTheme="Dark">
            <Button Click="Back_Click" ToolTipService.ToolTip="Back">
                <FontIcon Glyph="&#xE72B;" />
            </Button>
            <TextBlock Text="Multi-view" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center" />
            <TextBlock Text="Click a tile to hear it · right-click a channel anywhere and choose “Add to multi-view”" Foreground="#99FFFFFF"
                       VerticalAlignment="Center" Margin="12,0,0,0" />
            <Button Click="FullScreen_Click" ToolTipService.ToolTip="Full screen">
                <FontIcon Glyph="&#xE740;" />
            </Button>
        </StackPanel>
        <Grid x:Name="Slots" Grid.Row="1" RowSpacing="2" ColumnSpacing="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
        </Grid>
    </Grid>
</Page>
