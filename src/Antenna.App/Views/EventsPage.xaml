<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Antenna.App.Views.EventsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Antenna.App.ViewModels"
    xmlns:views="using:Antenna.App.Views">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <views:ItemTemplates />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Page.Resources>

    <!-- Find a match or event across every guide and event channel:
         "man utd vs man city", "NBA", "Djokovic", "F1". Tick several and watch them together. -->
    <Grid Padding="24,16,16,0" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Spacing="12">
            <TextBlock Text="Live events" Style="{StaticResource TitleTextBlockStyle}" />
            <ProgressRing x:Name="Busy" Width="20" Height="20" IsActive="False" VerticalAlignment="Center" />
        </StackPanel>

        <Grid Grid.Row="1" ColumnSpacing="8" MaxWidth="900" HorizontalAlignment="Left">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="QueryBox" PlaceholderText="Search a match, team, league or sport… e.g. man utd vs man city, NBA, Wimbledon"
                     KeyDown="QueryBox_KeyDown" MinWidth="520" />
            <Button Grid.Column="1" Content="Search" Style="{StaticResource AccentButtonStyle}" Click="Search_Click" />
        </Grid>

        <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" HorizontalScrollMode="Enabled">
            <StackPanel x:Name="Chips" Orientation="Horizontal" Spacing="6" Padding="0,0,0,6" />
        </ScrollViewer>

        <Grid Grid.Row="3" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <SelectorBar x:Name="WhenFilter" SelectionChanged="When_SelectionChanged">
                <SelectorBarItem Text="Live now" Tag="now" />
                <SelectorBarItem Text="Today" Tag="today" IsSelected="True" />
                <SelectorBarItem Text="Next 7 days" Tag="week" />
                <SelectorBarItem Text="Catch-up" Tag="past" />
            </SelectorBar>
            <Button x:Name="WatchTogether" Grid.Column="1" Style="{StaticResource AccentButtonStyle}" Visibility="Collapsed" Click="WatchTogether_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xF0E2;" FontSize="14" />
                    <TextBlock x:Name="WatchTogetherText" />
                </StackPanel>
            </Button>
        </Grid>

        <ScrollViewer Grid.Row="4">
            <StackPanel Spacing="12" Padding="0,0,0,24">
                <TextBlock x:Name="EventsHeader" Text="On TV" Style="{StaticResource SubtitleTextBlockStyle}" Visibility="Collapsed" />
                <ListView x:Name="Events" SelectionMode="Multiple" IsItemClickEnabled="True"
                          ItemClick="Events_ItemClick" SelectionChanged="Selection_Changed" RightTapped="Events_RightTapped">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:EventViewModel">
                            <Grid Padding="0,10" ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="4" />
                                    <ColumnDefinition Width="56" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Background="{x:Bind SourceBrush}" CornerRadius="2" />
                                <Grid Grid.Column="1" Height="40" CornerRadius="6" Background="{ThemeResource SubtleFillColorSecondaryBrush}" VerticalAlignment="Top">
                                    <Image Source="{x:Bind Logo.Source, Mode=OneWay}" Stretch="Uniform" Margin="4" />
                                </Grid>
                                <StackPanel Grid.Column="2" Spacing="3">
                                    <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.75">
                                        <Run Text="{x:Bind When}" /><Run Text="  ·  " /><Run Text="{x:Bind Channels}" />
                                    </TextBlock>
                                    <TextBlock Text="{x:Bind Description}" Opacity="0.65" TextWrapping="Wrap" MaxLines="2" TextTrimming="WordEllipsis" />
                                    <ProgressBar Value="{x:Bind Progress}" Maximum="100" Visibility="{x:Bind ProgressVisibility}" MaxWidth="320" HorizontalAlignment="Left" />
                                </StackPanel>
                                <TextBlock Grid.Column="3" Text="{x:Bind State}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" FontWeight="SemiBold" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <TextBlock x:Name="ChannelsHeader" Text="Event channels" Style="{StaticResource SubtitleTextBlockStyle}" Visibility="Collapsed" />
                <GridView x:Name="EventChannels" SelectionMode="Multiple" IsItemClickEnabled="True"
                          ItemClick="EventChannels_ItemClick" SelectionChanged="Selection_Changed" RightTapped="EventChannels_RightTapped"
                          ItemTemplate="{StaticResource ItemTileTemplate}" />

                <StackPanel x:Name="EmptyState" Spacing="8" Visibility="Collapsed" Margin="0,40,0,0" HorizontalAlignment="Center">
                    <TextBlock x:Name="EmptyTitle" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" />
                    <TextBlock x:Name="EmptyDetail" Opacity="0.7" TextWrapping="Wrap" MaxWidth="520" TextAlignment="Center" HorizontalAlignment="Center" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <InfoBar x:Name="Status" Grid.Row="4" VerticalAlignment="Bottom" IsClosable="True" />
    </Grid>
</Page>
