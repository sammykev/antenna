<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    x:Class="Antenna.App.Views.ItemTemplates"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Antenna.App.Views"
    xmlns:vm="using:Antenna.App.ViewModels">

    <!--
        Live channel card: the logo on a 16:9 panel, then the channel and what's on now with its
        progress. The thin bar on the panel's edge is the playlist's colour.
    -->
    <DataTemplate x:Key="ItemTileTemplate" x:DataType="vm:ItemViewModel">
        <StackPanel Width="224" Spacing="8" views:Lift.On="True">
            <Grid Height="126" CornerRadius="{StaticResource CardRadius}" Background="{ThemeResource CardFillBrush}"
                  BorderBrush="{ThemeResource CardStrokeBrush}" BorderThickness="1">
                <TextBlock Text="{x:Bind Initials}" Visibility="{x:Bind Logo.FallbackVisibility, Mode=OneWay}" FontSize="30" FontWeight="SemiBold" Opacity="0.35"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                <Image Source="{x:Bind Logo.Source, Mode=OneWay}" Stretch="Uniform" Margin="36,22" />
                <TextBlock Text="{x:Bind NumberText}" Margin="12,8" Style="{StaticResource MutedTextStyle}"
                           HorizontalAlignment="Left" VerticalAlignment="Top" />
                <FontIcon Glyph="&#xE735;" Visibility="{x:Bind FavouriteVisibility, Mode=OneWay}" FontSize="13" Margin="10"
                          Foreground="{StaticResource FavouriteBrush}" HorizontalAlignment="Right" VerticalAlignment="Top" />
                <Border Height="3" VerticalAlignment="Bottom" Background="{x:Bind SourceBrush}" Opacity="0.9" />
                <ProgressBar Value="{x:Bind NowProgress}" Maximum="100" Visibility="{x:Bind NowVisibility}"
                             VerticalAlignment="Bottom" Margin="12,0,12,10" MinHeight="3" />
            </Grid>
            <StackPanel Spacing="1" Padding="2,0">
                <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Title}" />
                <TextBlock Text="{x:Bind Subtitle}" Style="{StaticResource MutedTextStyle}" />
            </StackPanel>
        </StackPanel>
    </DataTemplate>

    <!-- Movie / series poster (2:3): artwork carries the card, the title sits underneath. -->
    <DataTemplate x:Key="PosterTileTemplate" x:DataType="vm:ItemViewModel">
        <StackPanel Width="164" Spacing="8" views:Lift.On="True">
            <Grid Height="246" CornerRadius="{StaticResource CardRadius}" Background="{ThemeResource CardFillBrush}">
                <TextBlock Text="{x:Bind Initials}" Visibility="{x:Bind Logo.FallbackVisibility, Mode=OneWay}" FontSize="34" FontWeight="SemiBold" Opacity="0.3"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                <Image Source="{x:Bind Logo.Source, Mode=OneWay}" Stretch="UniformToFill" />
                <Border Height="3" VerticalAlignment="Bottom" Background="{x:Bind SourceBrush}" Opacity="0.9" />
                <Border Visibility="{x:Bind FavouriteVisibility, Mode=OneWay}" Margin="8" Padding="5" CornerRadius="12" Background="#99000000"
                        HorizontalAlignment="Right" VerticalAlignment="Top">
                    <FontIcon Glyph="&#xE735;" FontSize="11" Foreground="{StaticResource FavouriteBrush}" />
                </Border>
            </Grid>
            <StackPanel Spacing="1" Padding="2,0">
                <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Title}" />
                <TextBlock Text="{x:Bind SourceName}" Style="{StaticResource MutedTextStyle}" />
            </StackPanel>
        </StackPanel>
    </DataTemplate>

    <!-- Continue watching: a wide card with the artwork, a fade, the title on it and progress along the bottom. -->
    <DataTemplate x:Key="WatchCardTemplate" x:DataType="vm:WatchViewModel">
        <Grid Width="304" Height="171" CornerRadius="{StaticResource CardRadius}" Background="{ThemeResource CardFillBrush}"
              BorderBrush="{ThemeResource CardStrokeBrush}" BorderThickness="1" views:Lift.On="True">
            <TextBlock Text="{x:Bind Initials}" Visibility="{x:Bind Logo.FallbackVisibility, Mode=OneWay}" FontSize="34" FontWeight="SemiBold" Opacity="0.3"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,30" />
            <Image Source="{x:Bind Logo.Source, Mode=OneWay}" Stretch="{x:Bind ImageStretch}" Margin="{x:Bind ImageMargin}" />
            <Rectangle>
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0.35" EndPoint="0,1">
                        <GradientStop Color="#00000000" Offset="0" />
                        <GradientStop Color="#E6000000" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <StackPanel VerticalAlignment="Bottom" Padding="14,0,14,14" Spacing="2" RequestedTheme="Dark">
                <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" Foreground="White" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Title}" />
                <TextBlock Text="{x:Bind Details}" FontSize="12" Foreground="#B3FFFFFF" TextTrimming="CharacterEllipsis" />
                <ProgressBar Value="{x:Bind Progress}" Maximum="100" Visibility="{x:Bind ProgressVisibility}" Margin="0,6,0,0" />
            </StackPanel>
        </Grid>
    </DataTemplate>

    <!-- Live TV list row: number, logo, channel, what's on now and how far through it is. -->
    <DataTemplate x:Key="ChannelRowTemplate" x:DataType="vm:ItemViewModel">
        <Grid Height="64" ColumnSpacing="12" Padding="0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="34" />
                <ColumnDefinition Width="76" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{x:Bind NumberText}" Style="{StaticResource MutedTextStyle}" HorizontalAlignment="Right" VerticalAlignment="Center" />
            <Grid Grid.Column="1" CornerRadius="8" Background="{ThemeResource CardFillBrush}" BorderBrush="{ThemeResource CardStrokeBrush}" BorderThickness="1">
                <TextBlock Text="{x:Bind Initials}" Visibility="{x:Bind Logo.FallbackVisibility, Mode=OneWay}" FontWeight="SemiBold" Opacity="0.4"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                <Image Source="{x:Bind Logo.Source, Mode=OneWay}" Stretch="Uniform" Margin="8,5" />
                <Border Width="3" HorizontalAlignment="Left" Background="{x:Bind SourceBrush}" />
            </Grid>
            <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Title}" />
                <TextBlock Text="{x:Bind Subtitle}" Style="{StaticResource MutedTextStyle}" />
                <ProgressBar Value="{x:Bind NowProgress}" Maximum="100" Visibility="{x:Bind NowVisibility}" MaxWidth="160" HorizontalAlignment="Left" Margin="0,3,0,0" />
            </StackPanel>
            <FontIcon Grid.Column="3" Glyph="&#xE735;" Visibility="{x:Bind FavouriteVisibility, Mode=OneWay}" FontSize="12"
                      Foreground="{StaticResource FavouriteBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
        </Grid>
    </DataTemplate>

    <!-- Continue watching / recently watched as a list row (My list). -->
    <DataTemplate x:Key="WatchRowTemplate" x:DataType="vm:WatchViewModel">
        <Grid Padding="0,8" ColumnSpacing="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="112" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid Height="63" CornerRadius="8" Background="{ThemeResource CardFillBrush}">
                <TextBlock Text="{x:Bind Initials}" Visibility="{x:Bind Logo.FallbackVisibility, Mode=OneWay}" Opacity="0.4" HorizontalAlignment="Center" VerticalAlignment="Center" />
                <Image Source="{x:Bind Logo.Source, Mode=OneWay}" Stretch="{x:Bind ImageStretch}" />
            </Grid>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{x:Bind Details}" Style="{StaticResource MutedTextStyle}" />
                <ProgressBar Value="{x:Bind Progress}" Maximum="100" Visibility="{x:Bind ProgressVisibility}" />
            </StackPanel>
        </Grid>
    </DataTemplate>
</ResourceDictionary>
