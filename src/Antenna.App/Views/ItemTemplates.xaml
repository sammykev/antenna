<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    x:Class="Antenna.App.Views.ItemTemplates"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Antenna.App.ViewModels">

    <!-- Live channel tile: logo, number, what's on now with progress. The coloured bar shows the playlist. -->
    <DataTemplate x:Key="ItemTileTemplate" x:DataType="vm:ItemViewModel">
        <Grid Width="200" Height="196" CornerRadius="8"
              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="104" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                <Grid>
                    <TextBlock Text="{x:Bind Initials}" FontSize="28" FontWeight="SemiBold" Opacity="0.4"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <Image Source="{x:Bind Logo.Source, Mode=OneWay}" Stretch="Uniform" Margin="14" />
                    <TextBlock Text="{x:Bind NumberText}" Margin="10,6" FontSize="12" Opacity="0.6"
                               HorizontalAlignment="Left" VerticalAlignment="Top" />
                    <FontIcon Glyph="{x:Bind FavouriteGlyph, Mode=OneWay}" FontSize="14" Margin="8"
                              Foreground="#F5A524" HorizontalAlignment="Right" VerticalAlignment="Top" />
                </Grid>
            </Border>

            <Border Width="4" HorizontalAlignment="Left" Background="{x:Bind SourceBrush}" Grid.RowSpan="2" />

            <StackPanel Grid.Row="1" Padding="12,8,10,8" Spacing="2">
                <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Title}" />
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="{x:Bind SourceIcon}" FontSize="12" Foreground="{x:Bind SourceBrush}" />
                    <TextBlock Text="{x:Bind SourceName}" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <TextBlock Text="{x:Bind Badge}" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.6" />
                <TextBlock Text="{x:Bind NowText}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                <ProgressBar Value="{x:Bind NowProgress}" Maximum="100" Visibility="{x:Bind NowVisibility}" Margin="0,2,0,0" />
            </StackPanel>
        </Grid>
    </DataTemplate>

    <!-- Movie / series poster tile (2:3). -->
    <DataTemplate x:Key="PosterTileTemplate" x:DataType="vm:ItemViewModel">
        <Grid Width="156" RowSpacing="6">
            <Grid.RowDefinitions>
                <RowDefinition Height="234" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid CornerRadius="8" Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <TextBlock Text="{x:Bind Initials}" FontSize="32" FontWeight="SemiBold" Opacity="0.35"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                <Image Source="{x:Bind Logo.Source, Mode=OneWay}" Stretch="UniformToFill" />
                <Border Height="4" VerticalAlignment="Bottom" Background="{x:Bind SourceBrush}" />
                <Border Margin="6" Padding="4" CornerRadius="12" Background="#99000000"
                        HorizontalAlignment="Right" VerticalAlignment="Top">
                    <FontIcon Glyph="{x:Bind FavouriteGlyph, Mode=OneWay}" FontSize="12" Foreground="#F5A524" />
                </Border>
            </Grid>
            <StackPanel Grid.Row="1" Spacing="0">
                <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxLines="2" TextWrapping="Wrap"
                           ToolTipService.ToolTip="{x:Bind Title}" />
                <TextBlock Text="{x:Bind SourceName}" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.6" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Grid>
    </DataTemplate>

    <!-- Continue watching / recently watched row. -->
    <DataTemplate x:Key="WatchRowTemplate" x:DataType="vm:WatchViewModel">
        <Grid Padding="0,8" ColumnSpacing="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="96" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid Height="54" CornerRadius="6" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                <TextBlock Text="{x:Bind Initials}" Opacity="0.4" HorizontalAlignment="Center" VerticalAlignment="Center" />
                <Image Source="{x:Bind Logo.Source, Mode=OneWay}" Stretch="UniformToFill" />
            </Grid>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{x:Bind Details}" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" />
                <ProgressBar Value="{x:Bind Progress}" Maximum="100" Visibility="{x:Bind ProgressVisibility}" />
            </StackPanel>
        </Grid>
    </DataTemplate>
</ResourceDictionary>
