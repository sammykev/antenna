<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Antenna.App.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Antenna.App.Views">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <views:ItemTemplates />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Page.Resources>

    <!-- Home: what's in the library (click a count to go there), then things to pick up again. -->
    <ScrollViewer>
        <StackPanel Padding="32,24,32,32" Spacing="28" MaxWidth="1400">
            <StackPanel Orientation="Horizontal" Spacing="16">
                <Image x:Name="Logo" Width="64" Height="64" />
                <StackPanel VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="Antenna" Style="{StaticResource TitleTextBlockStyle}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ProgressRing x:Name="LoadingRing" Width="14" Height="14" IsActive="True" />
                        <TextBlock x:Name="StatusText" Text="Loading your library…" Opacity="0.7" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="16">
                <Button Tag="live" Click="Count_Click" Width="196" Padding="20,18" CornerRadius="12"
                        HorizontalContentAlignment="Stretch" ToolTipService.ToolTip="Open Live TV"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                    <StackPanel Spacing="6">
                        <FontIcon Glyph="&#xE7F4;" FontSize="20" HorizontalAlignment="Left" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        <TextBlock x:Name="LiveCount" Text="–" FontSize="34" FontWeight="SemiBold" />
                        <TextBlock Text="Live channels" Opacity="0.7" />
                    </StackPanel>
                </Button>
                <Button Tag="movies" Click="Count_Click" Width="196" Padding="20,18" CornerRadius="12"
                        HorizontalContentAlignment="Stretch" ToolTipService.ToolTip="Open Movies"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                    <StackPanel Spacing="6">
                        <FontIcon Glyph="&#xE8B2;" FontSize="20" HorizontalAlignment="Left" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        <TextBlock x:Name="MovieCount" Text="–" FontSize="34" FontWeight="SemiBold" />
                        <TextBlock Text="Movies" Opacity="0.7" />
                    </StackPanel>
                </Button>
                <Button Tag="series" Click="Count_Click" Width="196" Padding="20,18" CornerRadius="12"
                        HorizontalContentAlignment="Stretch" ToolTipService.ToolTip="Open Series"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                    <StackPanel Spacing="6">
                        <FontIcon Glyph="&#xE7F7;" FontSize="20" HorizontalAlignment="Left" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        <TextBlock x:Name="SeriesCount" Text="–" FontSize="34" FontWeight="SemiBold" />
                        <TextBlock Text="Series" Opacity="0.7" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <StackPanel x:Name="ContinueSection" Spacing="8" Visibility="Collapsed">
                <TextBlock Text="Continue watching" Style="{StaticResource SubtitleTextBlockStyle}" />
                <GridView x:Name="ContinueList" IsItemClickEnabled="True" SelectionMode="None" ItemClick="Watch_ItemClick"
                          ItemTemplate="{StaticResource WatchRowTemplate}">
                    <GridView.ItemContainerStyle>
                        <Style TargetType="GridViewItem" BasedOn="{StaticResource DefaultGridViewItemStyle}">
                            <Setter Property="Width" Value="360" />
                            <Setter Property="Padding" Value="8,0" />
                        </Style>
                    </GridView.ItemContainerStyle>
                </GridView>
            </StackPanel>

            <StackPanel x:Name="OnNowSection" Spacing="8" Visibility="Collapsed">
                <TextBlock Text="Your channels, on now" Style="{StaticResource SubtitleTextBlockStyle}" />
                <GridView x:Name="OnNowList" IsItemClickEnabled="True" SelectionMode="None" ItemClick="Channel_ItemClick"
                          RightTapped="Channel_RightTapped" ItemTemplate="{StaticResource ItemTileTemplate}" />
            </StackPanel>

            <StackPanel x:Name="RecentSection" Spacing="8" Visibility="Collapsed">
                <TextBlock Text="Recently watched" Style="{StaticResource SubtitleTextBlockStyle}" />
                <GridView x:Name="RecentList" IsItemClickEnabled="True" SelectionMode="None" ItemClick="Watch_ItemClick"
                          ItemTemplate="{StaticResource WatchRowTemplate}">
                    <GridView.ItemContainerStyle>
                        <Style TargetType="GridViewItem" BasedOn="{StaticResource DefaultGridViewItemStyle}">
                            <Setter Property="Width" Value="360" />
                            <Setter Property="Padding" Value="8,0" />
                        </Style>
                    </GridView.ItemContainerStyle>
                </GridView>
            </StackPanel>

            <StackPanel x:Name="EmptySection" Spacing="8" Visibility="Collapsed">
                <TextBlock Text="Nothing here yet" Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBlock Opacity="0.7" TextWrapping="Wrap"
                           Text="Watch something, or right-click a channel and choose “Add to favourites”, and it will show up here." />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
