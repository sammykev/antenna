<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="Antenna.App.Views.AddPlaylistDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Add playlist"
    PrimaryButtonText="Add"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    PrimaryButtonClick="ContentDialog_PrimaryButtonClick">

    <StackPanel Spacing="12" MinWidth="420">
        <RadioButtons x:Name="KindChoice" Header="Type" SelectedIndex="0" MaxColumns="3" SelectionChanged="KindChoice_SelectionChanged">
            <x:String>M3U URL</x:String>
            <x:String>M3U file</x:String>
            <x:String>Xtream Codes</x:String>
        </RadioButtons>

        <TextBox x:Name="NameBox" Header="Name" PlaceholderText="My provider" />

        <TextBox x:Name="UrlBox" Header="Playlist URL" PlaceholderText="http://provider.example/get.php?..." InputScope="Url" />

        <Grid x:Name="FilePanel" ColumnSpacing="8" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="FileBox" Header="Playlist file" IsReadOnly="True" />
            <Button Grid.Column="1" Content="Browse…" VerticalAlignment="Bottom" Click="Browse_Click" />
        </Grid>

        <StackPanel x:Name="XtreamPanel" Spacing="12" Visibility="Collapsed">
            <TextBox x:Name="ServerBox" Header="Server" PlaceholderText="http://provider.example:8080" InputScope="Url" />
            <TextBox x:Name="UserBox" Header="Username" />
            <PasswordBox x:Name="PasswordBox" Header="Password" />
        </StackPanel>

        <TextBox x:Name="EpgBox" Header="EPG (XMLTV) URL — optional" PlaceholderText="Detected from the playlist when available" InputScope="Url" />

        <StackPanel Spacing="4">
            <TextBlock Text="Colour" />
            <GridView x:Name="ColorChoice" SelectionMode="Single" />
        </StackPanel>

        <InfoBar x:Name="Error" Severity="Error" IsClosable="False" />
    </StackPanel>
</ContentDialog>
